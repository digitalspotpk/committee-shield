# --- Neon PostgreSQL (use the pooled connection string from the Neon console) ---
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"
# GitHub OAuth app (callback URL: https://YOUR_DOMAIN/api/auth/callback/github)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# The account with this email is always promoted to Super Admin
SUPER_ADMIN_EMAIL="admin@example.com"
# Used only by `npm run db:seed` to create the Super Admin credentials login
SUPER_ADMIN_PASSWORD="ChangeMe123!"
SUPER_ADMIN_NAME="Super Admin"

# --- ImgBB (https://api.imgbb.com/) — kept server-side only ---
IMGBB_API_KEY=""

# --- Committee rules ---
MAX_MEMBERS=12
MONTHLY_CONTRIBUTION=10000
# Set to "true" if admins also take part in the monthly draw
ADMINS_IN_DRAW=false
NEXT_PUBLIC_CURRENCY="PKR"
NEXT_PUBLIC_APP_NAME="Committee Shield"
